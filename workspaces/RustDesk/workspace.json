{
  "description": "RustDesk is a full-featured open source remote control alternative for self-hosting and security with minimal configuration.",
  "docker_registry": "https://index.docker.io/v1/",
  "image_src": "rustdesk.png",
  "run_config": {
    "hostname": "kasm"
  },
  "exec_config": {
    "go": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --go --url \"$KASM_URL\"'"
    },
    "assign": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --assign --url \"$KASM_URL\"'"
    }
  },
  "categories": [
    "Productivity"
  ],
  "friendly_name": "RustDesk",
  "architecture": [
    "amd64"
  ],
  "compatibility": [
    {
      "version": "1.18.x",
      "image": "slewantoski/kasm-rustdesk:latest",
      "uncompressed_size_mb": 3912,
      "available_tags": [
        "latest"
      ]
    }
  ]
}