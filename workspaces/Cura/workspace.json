{
  "description": "UltiMaker Cura is free, easy-to-use 3D printing software trusted by millions of users. Fine-tune your 3D model with 400+ settings for the best slicing and printing results.",
  "docker_registry": "https://index.docker.io/v1/",
  "image_src": "cura.png",
  "run_config": {
    "hostname": "kasm"
  },
  "exec_config": {
    "go": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --go --url \"$KASM_URL\"'"
    },
    "assign": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --assign --url \"$KASM_URL\"'"
    }
  },
  "categories": [
    "Productivity",
	"Multimedia"
  ],
  "friendly_name": "UltiMaker Cura",
  "architecture": [
    "amd64"
  ],
  "compatibility": [
    {
      "version": "1.17.x",
      "image": "slewantoski/kasm-cura:latest",
      "uncompressed_size_mb": 2074,
      "available_tags": [
        "1.17.0-rolling-weekly"
      ]
    }
  ]
}