{
  "description": "Ubuntu is a Linux distribution based on Debian. This Desktop is customized with some Software",
  "docker_registry": "https://index.docker.io/v1/",
  "image_src": "ubuntu.png",
  "run_config": {
    "hostname": "kasm"
  },
  "exec_config": {
    "go": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --go --url \"$KASM_URL\"'"
    },
    "assign": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --assign --url \"$KASM_URL\"'"
    }
  },
  "categories": [
    "Productivity",
	"Desktop",
	"Development"
  ],
  "friendly_name": "Ubuntu Noble Desktop",
  "architecture": [
    "amd64"
  ],
  "compatibility": [
    {
      "version": "1.17.x",
      "image": "slewantoski/kasm-nobledesktop:latest",
      "uncompressed_size_mb": 28672,
      "available_tags": [
        "latest"
      ]
    }
  ]
}